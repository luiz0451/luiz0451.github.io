---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { VideoEmbed } from "../utils/video-embed";

interface Props {
    entry: CollectionEntry<"gallery">;
    video: VideoEmbed | null;
    /** card: cropped 16:9 thumbnail linking to the page. page: full media. */
    variant: "card" | "page";
}

const { entry, video, variant } = Astro.props;
const { title, image, alt } = entry.data;
const full = variant === "page";
---

{video?.kind === "iframe" ? (
    <iframe
        class:list={["gallery-media", full && "gallery-media-full"]}
        src={video.src}
        title={title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
    ></iframe>
) : video?.kind === "file" ? (
    <video class:list={["gallery-media", full && "gallery-media-full"]} src={video.src} controls preload="metadata" playsinline></video>
) : image ? (
    full ? (
        <Image src={image} alt={alt ?? ""} width={1400} class="gallery-image-full" loading="eager" />
    ) : (
        <a href={`/gallery/${entry.id}/`}>
            <Image src={image} alt={alt ?? ""} width={800} height={450} class="gallery-media" loading="lazy" />
        </a>
    )
) : null}
