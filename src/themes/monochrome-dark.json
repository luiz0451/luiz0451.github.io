{
  "name": "monochrome-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#333233",
    "editor.foreground": "#e6e6e6"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#808080", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#cccccc" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#bbbbbb" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#f2f2f2" }
    },
    {
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": { "foreground": "#d9d9d9" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#aaaaaa" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    }
  ]
}
