---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { formatDate } from "../utils/format-date";

const { frontmatter, headings = [] } = Astro.props;

const { title, description, tldr, date, publishDate, tags } = frontmatter || Astro.props;
const createdTime = date ? new Date(date).toISOString() : undefined;
const publishedTime = publishDate ? new Date(publishDate).toISOString() : undefined;
const shouldShowBothDates = Boolean(
    date &&
    publishDate &&
    new Date(date).getTime() !== new Date(publishDate).getTime(),
);
const tagClass = (index: number) => `tag-link-${index % 6}`;
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const articleSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url: postUrl,
    datePublished: publishedTime,
    dateCreated: createdTime,
    dateModified: publishedTime,
    author: {
        "@type": "Person",
        name: "Luiz Gustavo",
        url: Astro.site?.toString(),
    },
    publisher: {
        "@type": "Person",
        name: "Luiz Gustavo",
        url: Astro.site?.toString(),
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": postUrl,
    },
    keywords: tags,
    inLanguage: "pt-BR",
};
---

<BaseLayout
    title={title}
    description={description}
    ogType="article"
    publishedTime={publishedTime}
    keywords={tags}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <article class="w-full">
        <header class="mb-8">
            <h1>{title}</h1>

            <div class="meta-line mt-3">
                {publishDate && !shouldShowBothDates && (
                    <time datetime={new Date(publishDate).toISOString()}>
                        {formatDate(publishDate)}
                    </time>
                )}

                {publishDate && shouldShowBothDates && (
                    <>
                        <span>publicado:</span>
                        <time datetime={new Date(publishDate).toISOString()}>
                            {formatDate(publishDate)}
                        </time>
                    </>
                )}

                {date && shouldShowBothDates && (
                    <>
                        <span>/</span>
                        <span>criado:</span>
                        <time datetime={new Date(date).toISOString()}>
                            {formatDate(date)}
                        </time>
                    </>
                )}

                {tags && tags.length > 0 && (
                    <>
                        <div class="flex w-full flex-wrap gap-2">
                            {tags.map((tag: string, index: number) => (
                                <a href={`/tags/${tag}`} class={tagClass(index)}>#{tag}</a>
                            ))}
                        </div>
                    </>
                )}
            </div>
        </header>

        {tldr && description && (
            <section class="tldr mb-8 text-justify hyphens-auto">
                <p class="tldr-label">tl;dr</p>
                <p class="mt-2">
                    {description}
                </p>
            </section>
        )}

        <TableOfContents headings={headings} />

        <div class="post-content">
            <slot />
        </div>
    </article>
</BaseLayout>

<script>
    document.addEventListener("click", (event) => {
        const term = (event.target as Element).closest(".term");
        document.querySelectorAll(".term.open").forEach((open) => {
            if (open !== term) open.classList.remove("open");
        });
        term?.classList.toggle("open");
    });
</script>
