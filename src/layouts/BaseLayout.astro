---
import "../styles/global.css";
import Footer from "@components/Footer.astro";
import "katex/dist/katex.min.css";

const {
    title,
    description,
    canonical = Astro.url,
    ogType = "website",
    publishedTime,
    modifiedTime,
    keywords = [],
    ogImage,
    bodyClass = "",
    showHeader = true,
} = Astro.props;

const siteName = "talkinghead";
const canonicalUrl = new URL(canonical, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const pageTitle = title ? `${siteName} - ${title}` : siteName;
const keywordContent = Array.isArray(keywords) ? keywords.join(", ") : keywords;

---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalUrl.toString()} />
        {keywordContent && <meta name="keywords" content={keywordContent} />}

        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalUrl.toString()} />
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

        <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

        {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )}
        {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
        )}

    </head>
    <body class:list={["flex min-h-screen flex-col", bodyClass]}>
        <div class="relative mx-auto flex w-full max-w-2xl flex-1 flex-col">
            {showHeader && (
                <header class="flex w-full flex-col px-6 pt-10 sm:px-16 lg:absolute lg:right-full lg:top-0 lg:w-auto lg:px-0">
                    <nav class="flex flex-row flex-wrap gap-x-4 gap-y-1 lg:flex-col lg:gap-y-2" aria-label="Principal">
                        <a href="/" class="text-(--theme-text) underline underline-offset-4 visited:text-(--theme-text) hover:text-(--theme-link)">talkinghead</a>
                        <a href="/posts/" class="text-(--theme-text) underline underline-offset-4 visited:text-(--theme-text) hover:text-(--theme-link)">posts</a>
                        <a href="/updates/" class="text-(--theme-text) underline underline-offset-4 visited:text-(--theme-text) hover:text-(--theme-link)">updates</a>
                    </nav>
                </header>
            )}
            <main class="mx-auto flex w-full flex-1 flex-col px-6 py-10 sm:px-16">
                <slot />
            </main>
            <slot name="footer"><Footer /></slot>
        </div>
    </body>
</html>
